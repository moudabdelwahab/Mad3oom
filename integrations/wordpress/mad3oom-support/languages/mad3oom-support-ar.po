msgid "Mad3oom endpoint host"
msgstr "عنوان خادم مدعوم"

#: includes/class-mad3oom-client.php:183
msgid "Mad3oom rejected the signature. Paste a new pairing code from your Mad3oom dashboard."
msgstr "رفض مدعوم التوقيع. الصق رمز اقتران جديدًا من لوحة مدعوم."

#: includes/class-mad3oom-admin.php:99
msgid "OK"
msgstr "يعمل"

