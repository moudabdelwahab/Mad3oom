#: includes/class-mad3oom-admin.php:63 includes/class-mad3oom-admin.php:64 includes/class-mad3oom-admin.php:124
msgid "Mad3oom Support"
msgstr "دعم مدعوم"

#: mad3oom-support.php:46
#, php-format
msgid "Mad3oom Support requires WordPress %1$s and PHP %2$s or newer."
msgstr "إضافة دعم مدعوم تتطلب ووردبريس %1$s و PHP %2$s أو أحدث."

