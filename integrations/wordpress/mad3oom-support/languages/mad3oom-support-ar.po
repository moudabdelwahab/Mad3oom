#: includes/class-mad3oom-woocommerce.php:65
msgid "Request support"
msgstr "طلب دعم"

#: includes/class-mad3oom-admin.php:169
msgid "Requests arrive in Mad3oom as support requests for your company admin to review. They are not tickets until the admin converts them for an existing customer."
msgstr "تصل الطلبات إلى مدعوم كطلبات دعم يراجعها مدير شركتك. لا تصبح تذاكر إلا حين يحوّلها المدير لعميل موجود."

#: templates/form.php:61
msgid "Send request"
msgstr "إرسال الطلب"

