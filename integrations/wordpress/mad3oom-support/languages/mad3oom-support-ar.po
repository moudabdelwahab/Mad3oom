msgid "Mad3oom answered: the connection works."
msgstr "ردّ مدعوم: الاتصال يعمل."

#: includes/class-mad3oom-client.php:191
msgid "Mad3oom could not be reached from this server."
msgstr "تعذّر الوصول إلى مدعوم من هذا الخادم."

