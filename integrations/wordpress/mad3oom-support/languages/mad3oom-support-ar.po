msgid "Open the support portal"
msgstr "افتح بوابة الدعم"

#: includes/class-mad3oom-admin.php:180
msgid "Optional HTTPS link shown by the [mad3oom_portal_link] shortcode."
msgstr "رابط HTTPS اختياري يعرضه الرمز المختصر [mad3oom_portal_link]."

#: includes/class-mad3oom-admin.php:93
msgid "PHP version"
msgstr "إصدار PHP"

#: includes/class-mad3oom-admin.php:154
